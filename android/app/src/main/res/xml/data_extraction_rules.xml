<?xml version="1.0" encoding="utf-8"?>
<!--
  رفيقة تحتفظ بالبيانات محليًا فقط. نمنع النسخ الاحتياطي السحابي ونقل
  البيانات بين الأجهزة تلقائيًا؛ النسخ الاحتياطي يتم فقط عبر Google Drive
  المشفّر بكلمة مرور من داخل التطبيق.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
